# ===== adaptIA - Variables de entorno =====
# Pega aquí tus API keys. NUNCA compartas este archivo ni lo subas a internet.

# Groq API (GRATIS) - https://console.groq.com
GROQ_API_KEY=

# ElevenLabs (voz) - https://elevenlabs.io  (opcional, si no se llena usa voz del sistema gratis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Twilio (SMS y WhatsApp) - https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Correo Gmail (usar "contraseña de aplicación", no tu contraseña normal)
EMAIL_ADDRESS=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
